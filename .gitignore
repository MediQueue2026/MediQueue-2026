# Root .gitignore for MediQueue Project

# Dependencies
**/node_modules
**/.pnpm-store

# Environment variables
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Build outputs
**/dist
**/build
**/.vite
**/.next

# Logs
**/logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user

# Temp / Local prototype artifacts
MediQueue-Prototype/
