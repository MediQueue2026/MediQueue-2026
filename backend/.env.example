# MediQueue Backend Environment Variables

PORT=5000
NODE_ENV=development

# Supabase Credentials (Create project on supabase.com and copy credentials)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Notification Provider Config (Options: 'twilio' or 'mock')
NOTIFICATION_PROVIDER=mock

# Twilio SMS Config (Required if NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Slot Configuration Defaults
DEFAULT_MAX_SLOTS_PER_HOUR=4
NO_SHOW_LATE_NUMBER_THRESHOLD=2
